# Database connection string (PostgreSQL)
# Optional: if PostgreSQL is not running locally, Sweety automatically falls back
# to an in-memory clinical database with demo data for instant zero-config preview!
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sweety

# JWT Secret for authentication
JWT_SECRET=sweety_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d

# Node Environment
NODE_ENV=development
PORT=3000
