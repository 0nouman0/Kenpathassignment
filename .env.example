# Copy this file to .env (in the repository root) and adjust the values.
# Every variable the app reads is listed here. There are no real secrets in this file.

# --- API server ---
# Port the Express API listens on.
PORT=4000

# PostgreSQL connection string: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Default matches docker-compose (POSTGRES_USER=sweety, POSTGRES_PASSWORD=sweety):
DATABASE_URL=postgresql://sweety:sweety@127.0.0.1:5432/sweety

# Secret used to sign login tokens. Use a long random string (for example: openssl rand -hex 32).
# Required when NODE_ENV=production.
JWT_SECRET=replace-me-with-a-long-random-string

# How long a login lasts (jsonwebtoken format: 7d, 12h, ...).
JWT_EXPIRES_IN=7d

# development | production. In production the login cookie is marked Secure (HTTPS only).
NODE_ENV=development

# --- docker-compose only ---
# Credentials for the PostgreSQL container started by docker-compose.yml.
POSTGRES_USER=sweety
POSTGRES_PASSWORD=sweety
POSTGRES_DB=sweety
