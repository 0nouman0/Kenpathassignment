# Database Configuration (PostgreSQL)
# Standard local PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sweety

# When PostgreSQL is unreachable or not started, Sweety automatically falls back
# to an isolated in-memory clinical database engine with pre-seeded data for instant evaluation.

# Authentication & Security
# Required in production: must be a strong random secret (at least 32 characters)
JWT_SECRET=sweety_super_secret_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# Feature Flags
# Set to 'true' to enable demo account hints on /login and auto-seeding demo data
DEMO_MODE=true

# Server Environment
NODE_ENV=development
PORT=3000
